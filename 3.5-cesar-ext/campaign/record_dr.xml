<root>
	<windowclass name="charsheet_dr">
		<script file="campaign/scripts/char_dr.lua" />
		<sheetdata>
			<frame_char name="toolbar">
				<anchored position="insidetop" height="46" />
			</frame_char>
			<label name="hint">
				<anchored to="toolbar" height="16">
					<top offset="14" />
					<left offset="140" />
					<right offset="-12" />
				</anchored>
				<static textres="cesar_label_drhint" />
			</label>
			<button_text name="button_add">
				<anchored to="toolbar" width="78" height="22">
					<top offset="12" />
					<left offset="12" />
				</anchored>
				<tooltip textres="cesar_tooltip_dradd" />
				<state textres="cesar_label_dradd" />
				<script>
					function onButtonPress()
						local w = Interface.openWindow("cesar_dr_add", "");
						if w and w.setCharacter then
							w.setCharacter(window.getDatabaseNode());
						end
					end
				</script>
			</button_text>
			<frame_char name="listframe">
				<anchored position="insidetop" offset="0,46">
					<bottom />
				</anchored>
			</frame_char>

			<genericcontrol name="header_dr">
				<anchored to="listframe" height="20">
					<top offset="12" />
					<left offset="12" />
					<right offset="-12" />
				</anchored>
				<frame name="groupbox" offset="10,10,10,10" />
				<disabled />
			</genericcontrol>
			<label name="label_dr">
				<anchored to="header_dr" position="insidetop" offset="-10,0" />
				<static textres="cesar_label_drkind" />
				<center />
			</label>
			<list_text name="list_dr">
				<anchored to="listframe">
					<top parent="header_dr" anchor="bottom" offset="8" />
					<left offset="16" />
					<right offset="-28" />
					<bottom anchor="center" offset="-36" />
				</anchored>
				<datasource>.damagereduction.drlist</datasource>
				<class>charsheet_dr_entry</class>
			</list_text>
			<scrollbar_content_base>
				<anchored to="list_dr" />
				<target>list_dr</target>
			</scrollbar_content_base>

			<genericcontrol name="header_resist">
				<anchored to="listframe" height="20">
					<top parent="list_dr" anchor="bottom" offset="12" />
					<left offset="12" />
					<right offset="-12" />
				</anchored>
				<frame name="groupbox" offset="10,10,10,10" />
				<disabled />
			</genericcontrol>
			<label name="label_resist">
				<anchored to="header_resist" position="insidetop" offset="-10,0" />
				<static textres="cesar_label_resistkind" />
				<center />
			</label>
			<list_text name="list_resist">
				<anchored to="listframe">
					<top parent="header_resist" anchor="bottom" offset="8" />
					<left offset="16" />
					<right offset="-28" />
					<bottom offset="-12" />
				</anchored>
				<datasource>.damagereduction.resistlist</datasource>
				<class>charsheet_dr_entry</class>
			</list_text>
			<scrollbar_content_base>
				<anchored to="list_resist" />
				<target>list_resist</target>
			</scrollbar_content_base>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_dr_entry">
		<margins control="8,6,12,6" />
		<sizelimits>
			<minimum height="36" />
		</sizelimits>
		<script>
			function editEntry()
				local node = getDatabaseNode();
				local nodeChar = DB.getChild(node, "....");
				local w = Interface.openWindow("cesar_dr_add", "");
				if w then
					if w.setCharacter then
						w.setCharacter(nodeChar);
					end
					if w.setEntry then
						w.setEntry(node);
					end
				end
			end
			function onDoubleClick()
				editEntry();
				return true;
			end
		</script>
		<sheetdata>
			<anchor_listitem_left_sm />
			<anchor_listitem_right_sm />
			<button_listitem_idelete_left name="idelete" />
			<button_text name="edit">
				<anchored to="rightanchor" width="52" height="22">
					<top offset="6" />
					<right offset="-4" />
				</anchored>
				<tooltip textres="cesar_tooltip_dredit" />
				<state textres="cesar_label_dredit" />
				<script>
					function onButtonPress()
						window.editEntry();
					end
				</script>
			</button_text>
			<stringfield name="label">
				<anchored to="leftanchor" height="22">
					<top offset="7" />
					<left relation="relative" offset="16" />
					<right parent="edit" anchor="left" relation="relative" offset="-12" />
				</anchored>
				<font>sheetlabel</font>
				<readonly />
			</stringfield>
		</sheetdata>
	</windowclass>

