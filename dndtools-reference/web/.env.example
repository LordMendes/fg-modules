# PostgreSQL connection string
DATABASE_URL="postgresql://dndtools:dndtools@localhost:5432/dndtools?schema=public"

# Connections per process (default 10). Keep this times the replica count below
# Postgres max_connections, with room for migrations and admin tools.
# DB_POOL_MAX=10
# Longest a single query may run, in ms (default 15000).
# DB_STATEMENT_TIMEOUT_MS=15000

# Redis (campaign live WebSocket fan-out). Required in production (startup warns if it is missing).
REDIS_URL="redis://127.0.0.1:6379"

# Dev-only: standalone campaign WS (scripts/dev.mjs). The browser still
# connects same-origin (ws://localhost:3000/ws/campaign/:id); Next rewrites
# that path to this process. Production uses the custom HTTP server.
# NEXT_PUBLIC_WS_URL is only needed when the WS host is not loopback.
# NEXT_PUBLIC_WS_URL="wss://ws.example.com"
WS_PORT=3001

# Secret for signing session nonces (generate with: openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-random-32-byte-secret"

# Stable key for Next.js server action ids across deploys and replicas.
# Required in production when more than one Node process serves the app.
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Auth session max age in seconds (default: 604800 = 7 days)
# AUTH_SESSION_MAX_AGE=604800

# Public site URL (sitemap chunks, robots, metadataBase, Open Graph, llms.txt)
# Production value: https://dnd-helper.com (set for build and runtime, then redeploy)
SITE_URL="http://localhost:3000"
# Legacy alias — SITE_URL takes precedence
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Import script path override for Docker (data mounted at /data/dndtools)
# DATA_DIR=/data/dndtools

# Cloudflare R2 (PC profile/token images)
R2_ENDPOINT="https://973c06941ad54fe0be572ea33ae7e5f7.r2.cloudflarestorage.com"
R2_BUCKET="dnd-helper"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_R2_PUBLIC_BASE_URL="https://pub-f74b850de3e6476e8302459341d9917e.r2.dev"

# GlitchTip / Sentry error tracking (optional; unset disables reporting)
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@errors.example.com/<project-id>"
# Link to the GlitchTip project dashboard (admin smoke test panel)
# NEXT_PUBLIC_ERROR_DASHBOARD_URL="https://errors.example.com/<org>/<project>"
# GlitchTip server URL for source map upload during `next build` (not the DSN host path)
# SENTRY_URL="https://errors.example.com"
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# Auth token with release and project write scopes (build-time only in Coolify)
# SENTRY_AUTH_TOKEN=""
# Override environment tag on events (defaults to NODE_ENV)
# SENTRY_ENVIRONMENT="production"
# Override release tag on events (defaults to SOURCE_COMMIT in Docker builds)
# SENTRY_RELEASE=""
