generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DomainType {
  CLERIC
  PSIONIC_DISCIPLINE
}

enum EntityCategory {
  SPELL
  FEAT
  MONSTER
  TEMPLATE
  CLASS
  SKILL
  EQUIPMENT
  ITEM
  RACE
  DEITY
  DOMAIN
  PSIONIC
  RULE
}

model Source {
  id       String  @id @default(cuid())
  name     String
  abbrev   String?
  edition  String

  spells     Spell[]
  feats      Feat[]
  monsters   Monster[]
  templates  Template[]
  classes    DndClass[]
  skills     Skill[]
  equipment  Equipment[]
  items      Item[]
  races      Race[]
  deities    Deity[]
  domains    Domain[]
  psionics   Psionic[]
  rules      Rule[]

  @@unique([name, abbrev, edition])
  @@index([abbrev])
  @@index([edition])
}

model Spell {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  school          String?
  schools         String[] @default([])
  disciplines     String[] @default([])
  subschool       String?
  castingTime     String?
  components      String?
  range           String?
  minLevel        Int?
  target          String?
  area            String?
  effect          String?
  duration        String?
  savingThrow     String?
  spellResistance String?
  searchVector    Unsupported("tsvector")?

  source       Source            @relation(fields: [sourceId], references: [id])
  classLevels  SpellClassLevel[]
  domains      SpellDomain[]
  domainSpells DomainSpell[]

  @@index([sourceId])
  @@index([school])
  @@index([subschool])
  @@index([name])
  @@index([externalId])
}

model Feat {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  featType        String?
  searchVector    Unsupported("tsvector")?

  source        Source        @relation(fields: [sourceId], references: [id])
  monsterFeats  MonsterFeat[]

  @@index([sourceId])
  @@index([featType])
  @@index([name])
}

model Monster {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  creatureType    String?
  subtypes        String?
  size            String?
  challengeRating String?
  challengeRatingNum Float?
  hitDice         String?
  hitDiceNum      Float?
  alignment       String?
  environment     String?
  treasure        String?
  searchVector    Unsupported("tsvector")?

  source         Source                  @relation(fields: [sourceId], references: [id])
  feats          MonsterFeat[]
  abilities      MonsterAbility[]
  templateSamples TemplateSampleMonster[]

  @@index([sourceId])
  @@index([creatureType])
  @@index([size])
  @@index([challengeRating])
  @@index([challengeRatingNum])
  @@index([hitDiceNum])
  @@index([alignment])
  @@index([environment])
  @@index([treasure])
  @@index([name])
}

model Template {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  templateType    String?
  crChange        String?
  levelAdjustment String?
  searchVector    Unsupported("tsvector")?

  source         Source                  @relation(fields: [sourceId], references: [id])
  sampleMonsters TemplateSampleMonster[]

  @@index([sourceId])
  @@index([name])
}

model DndClass {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  hitDie          String?
  skillPoints     String?
  isPrestige      Boolean  @default(false)
  searchVector    Unsupported("tsvector")?

  source         Source              @relation(fields: [sourceId], references: [id])
  spellLevels    SpellClassLevel[]
  psionicLevels  PsionicClassLevel[]

  @@index([sourceId])
  @@index([name])
  @@map("classes")
}

model Skill {
  id                String   @id @default(cuid())
  slug              String   @unique
  externalId        Int?
  name              String
  sourceUrl         String?
  scrapedAt         DateTime?
  sourceId          String
  indexData         Json     @default("{}")
  descriptionHtml   String?  @db.Text
  descriptionText   String?  @db.Text
  keyAbility        String?
  trainedOnly       Boolean?
  armorCheckPenalty Boolean?
  searchVector      Unsupported("tsvector")?

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([name])
}

model Equipment {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  kind            String?
  category        String?
  cost            String?
  weight          String?
  searchVector    Unsupported("tsvector")?

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([kind])
  @@index([name])
}

model Item {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  itemType        String?
  price           String?
  casterLevel     String?
  aura            String?
  searchVector    Unsupported("tsvector")?

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([itemType])
  @@index([name])
}

model Race {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  size            String?
  creatureType    String?
  levelAdjustment String?
  searchVector    Unsupported("tsvector")?

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([name])
}

model Deity {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  alignment       String?
  pantheon        String?
  portfolio       String?
  searchVector    Unsupported("tsvector")?

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([pantheon])
  @@index([name])
}

model Domain {
  id              String     @id @default(cuid())
  slug            String     @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json       @default("{}")
  descriptionHtml String?    @db.Text
  descriptionText String?    @db.Text
  grantedPowerHtml String?   @db.Text
  grantedPowerText String?   @db.Text
  domainType      DomainType @default(CLERIC)
  searchVector    Unsupported("tsvector")?

  source            Source              @relation(fields: [sourceId], references: [id])
  spells            SpellDomain[]
  domainSpells      DomainSpell[]
  psionicDisciplines PsionicDiscipline[]

  @@index([sourceId])
  @@index([domainType])
  @@index([name])
}

model Psionic {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  powerPoints     String?
  discipline      String?
  manifestingTime String?
  range           String?
  searchVector    Unsupported("tsvector")?

  source      Source              @relation(fields: [sourceId], references: [id])
  classes     PsionicClassLevel[]
  disciplines PsionicDiscipline[]

  @@index([sourceId])
  @@index([discipline])
  @@index([name])
}

model Rule {
  id              String   @id @default(cuid())
  slug            String   @unique
  externalId      Int?
  name            String
  sourceUrl       String?
  scrapedAt       DateTime?
  sourceId        String
  indexData       Json     @default("{}")
  descriptionHtml String?  @db.Text
  descriptionText String?  @db.Text
  category        String?
  subcategory     String?
  searchVector    Unsupported("tsvector")?

  source    Source           @relation(fields: [sourceId], references: [id])
  abilities MonsterAbility[]

  @@index([sourceId])
  @@index([category])
  @@index([name])
}

model SpellClassLevel {
  id      String @id @default(cuid())
  spellId String
  classId String
  level   Int

  spell Spell    @relation(fields: [spellId], references: [id], onDelete: Cascade)
  class DndClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([spellId, classId])
  @@index([classId])
  @@index([level])
}

model SpellDomain {
  id       String @id @default(cuid())
  spellId  String
  domainId String

  spell  Spell  @relation(fields: [spellId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([spellId, domainId])
  @@index([domainId])
}

model DomainSpell {
  id       String @id @default(cuid())
  domainId String
  spellId  String
  position Int

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  spell  Spell  @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([domainId, position])
  @@index([spellId])
}

model PsionicClassLevel {
  id        String @id @default(cuid())
  psionicId String
  classId   String
  level     Int

  psionic Psionic  @relation(fields: [psionicId], references: [id], onDelete: Cascade)
  class   DndClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([psionicId, classId])
  @@index([classId])
}

model PsionicDiscipline {
  id        String @id @default(cuid())
  psionicId String
  domainId  String
  level     Int?

  psionic Psionic @relation(fields: [psionicId], references: [id], onDelete: Cascade)
  domain  Domain  @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([psionicId, domainId])
  @@index([domainId])
}

model MonsterFeat {
  id        String @id @default(cuid())
  monsterId String
  featId    String

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  feat    Feat    @relation(fields: [featId], references: [id], onDelete: Cascade)

  @@unique([monsterId, featId])
  @@index([featId])
}

model MonsterAbility {
  id        String @id @default(cuid())
  monsterId String
  ruleId    String

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  rule    Rule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([monsterId, ruleId])
  @@index([ruleId])
}

model TemplateSampleMonster {
  id         String  @id @default(cuid())
  templateId String
  monsterId  String?
  sampleName String?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  monster  Monster? @relation(fields: [monsterId], references: [id], onDelete: SetNull)

  @@index([monsterId])
}

model UnresolvedRef {
  id           String         @id @default(cuid())
  fromCategory EntityCategory
  fromSlug     String
  toCategory   EntityCategory
  toSlug       String?
  toExternalId Int?
  field        String
  createdAt    DateTime       @default(now())

  @@index([fromCategory, fromSlug])
}

model ImportRun {
  id              String   @id @default(cuid())
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?
  recordCounts    Json     @default("{}")
  unresolvedCount Int      @default(0)
  status          String   @default("running")
  error           String?  @db.Text
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  username          String             @unique
  name              String?
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          UserSession[]
  lists             SavedList[]
  pcPlans           PcPlan[]
  campaignsAsDm     Campaign[]         @relation("CampaignDm")
  campaignMembers   CampaignMember[]
  campaignPcs       CampaignPc[]
  campaignRolls     CampaignRoll[]
  campaignActivities CampaignActivity[]
}

model PcPlan {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  shortcut   String?
  state      Json         @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  campaignPcs CampaignPc[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, shortcut])
}

model Campaign {
  id         String             @id @default(cuid())
  name       String
  joinCode   String             @unique
  dmUserId   String
  dm         User               @relation("CampaignDm", fields: [dmUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  members    CampaignMember[]
  pcs        CampaignPc[]
  rolls      CampaignRoll[]
  activities CampaignActivity[]

  @@index([dmUserId])
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "dm" | "player"
  role       String
  /// "pending" | "active"
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId])
}

model CampaignPc {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pcPlanId   String
  pcPlan     PcPlan   @relation(fields: [pcPlanId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, pcPlanId])
  @@index([campaignId])
  @@index([userId])
  @@index([pcPlanId])
}

model CampaignRoll {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String
  characterName String?
  kind          String
  label         String
  hidden        Boolean  @default(false)
  dice          Json
  modifier      Int      @default(0)
  iterativeModifiers Json?
  faces         Json
  faceSum       Int
  total         Int
  natural20     Boolean  @default(false)
  natural1      Boolean  @default(false)
  attackTotals  Json?
  createdAt     DateTime @default(now())

  @@index([campaignId, createdAt])
}

/// Campaign change log (PC edits, roster events). Not dice rolls.
model CampaignActivity {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actorUserId   String
  actor         User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  actorUsername String
  /// pc_update | pc_create | pc_attach | pc_unlink | pc_rename | member_join | member_leave | member_kick | member_invite
  kind          String
  summary       String
  details       Json     @default("[]")
  pcPlanId      String?
  pcName        String?
  /// PC owner or membership target (for player visibility filtering).
  subjectUserId String?
  createdAt     DateTime @default(now())

  @@index([campaignId, createdAt])
  @@index([campaignId, subjectUserId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SavedList {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     SavedListItem[]

  @@unique([userId, name])
}

model SavedListItem {
  id         String    @id @default(cuid())
  listId     String
  list       SavedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  category   String
  entitySlug String
  entityName String
  createdAt  DateTime  @default(now())

  @@unique([listId, category, entitySlug])
  @@index([listId])
}
